# Made by tools, not by hand: installed packages, builds, logs and Python's caches
**/node_modules/
**/dist/
**/*.log
**/__pycache__/
# Secrets: every .env file but the examples, and a server's own settings for server/start.sh
**/.env
**/.env.*
!**/.env.example
start.env
# What the gateway keeps about players (chats, memories, calendars) never leaves its server
/agent/data/
# Footage from broadcasts and other people's model weights: we may use them, not publish them
/web/public/media/*
/web/public/models/
# except the short sample clips for the highlight reel, trimmed from CC BY 3.0 videos (CREDITS.md)
!web/public/media/samples/
# players read from that footage (video/pose): Sapiens2 keypoints and SAM 2.1 outlines
web/public/data/highlight_people.json
video/pose/*.json

# demo video: recordings and renders are rebuilt by video/*.mjs
video/build/
video/*.mp4

# the raw results bundle keeps its logs (submission/results/README.md lists them)
!submission/results/*.log

# agents' own worktrees (git worktree), not part of this repository
.claude/worktrees/
