# The gateway runs on the same server as its model. Its port, and the web app origins allowed to call it from a browser:
PORT=8790
ALLOW_ORIGINS=http://127.0.0.1:5191,http://localhost:5191
# The agents' language model (agent/src/llm.js has the details). By default Muse Glimmer, Meta's open-weights model,
# served by Ollama on our own GPU:
LLM_URL=http://127.0.0.1:11435/v1
LLM_MODEL=muse-glimmer
# or Muse Spark on the Meta Model API, with its key (this file then holds a secret: it stays off every repository):
# MODEL_API_KEY=
# LLM_URL=https://api.meta.ai/v1
# LLM_MODEL=muse-spark-1.3
# Facebook Messenger: a Facebook Page and a Meta app with the Messenger product. Point the app's webhook at
# https://<your tunnel>/webhook/messenger with the verify token below, and subscribe the Page to "messages" and
# "messaging_postbacks". WEBHOOK_PORT serves the webhook alone on 127.0.0.1, for the tunnel to point at, e.g.
#   cloudflared tunnel --url http://127.0.0.1:8795
MESSENGER_PAGE_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_NAME=
WEBHOOK_PORT=8795
# Google Maps (Places API, text search): ratings for courts near you. A Maps demo key works (about 100 calls a day,
# no billing); GOOGLE_DAILY_LIMIT caps the calls a day (default 90).
GOOGLE_MAPS_API_KEY=
GOOGLE_DAILY_LIMIT=90
# The gateway's token: every API call and every A2A request to a member's agent needs "Authorization: Bearer <it>"
# (the web app sends VITE_AGENT_TOKEN from web/.env.local). Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Without it the API answers this machine only (AGENT_OPEN=1 opens it to the network).
AGENT_TOKEN=
# The members' agents (A2A): answered on this server only unless A2A_PUBLIC=1; your agent waits A2A_TIMEOUT_MS for an
# answer; A2A_TRANSPORT=local skips HTTP (tests). A talk cut off by a restart is resumed if it stopped less than
# RESUME_MAX_MIN minutes ago.
# A2A_PUBLIC=1
# A2A_TIMEOUT_MS=270000
# A2A_TRANSPORT=local
# Private calendars: your agent does not see the members' weeks; it proposes from yours, and the talk searches.
# A2A_PRIVATE=1
# RESUME_MAX_MIN=30
# A member's hard rules are kept by code (default); MEMBER_RULES=model leaves them to the model, for comparison.
# MEMBER_RULES=model
# The two-tier decision (a quick pick before the full agent): off by default, see docs/methods.md.
# A2A_QUICK=1
# The student (a member's agent's choice between times, by the distilled Llama 3.2 3B on the CPU, jev/serve.sh): on by
# default; off asks Muse Glimmer every time. Below A2A_STUDENT_SURE, or with the worker down, Glimmer answers.
# A2A_STUDENT=off
# A2A_STUDENT_URL=http://127.0.0.1:11447
# A2A_STUDENT_SURE=0.5
# A2A_STUDENT_TIMEOUT_MS=30000
# The Autopilot's lean prompt (a static system prompt and the facts it needs first): on by default.
# AUTOPILOT_LEAN=0
# Per-call-site reasoning budgets, as JSON, e.g. {"a2a.answer": 600}
# LLM_BUDGETS=
# Simulated members added to the demo club (each with an A2A agent), for tests at scale; SIM_ONLY=1 leaves the demo
# members out
# SIM_MEMBERS=300
# SIM_SEED=7

# Traces (OpenTelemetry, GenAI conventions) go to data/traces.jsonl; an OTLP collector too if set
# TRACE_FILE=data/traces.jsonl
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# The token ledger (every model call's tokens, by call site)
# LEDGER_FILE=data/ledger.jsonl

# Voice notes (Meta's Omnilingual ASR, agent/asr/worker.py): its Python, the model card, and the device
# ASR_PYTHON=/home/you/shuttlecoach-meta/asr/env/bin/python
# ASR_MODEL=omniASR_CTC_1B
# ASR_DEVICE=cpu

# Highlight reels from the player's own video (video/pose/reel.py: DETR, Sapiens2, SAM 2.1 on the GPU)
REEL_PYTHON=/path/to/python-with-torch-and-transformers
REEL_SCRIPT=/path/to/video/pose/reel.py
REEL_GPU=0
REEL_HF_CACHE=
REEL_MAX_MB=300

# The club feed (agent/src/feed, docs/club_feed.md): its file and media, the reading agent's daily run (it posts the
# community loop's feed.papers.perWeek papers a week, spread out), and the demo club's simulated posts
# FEED_FILE=data/feed.json
# FEED_MEDIA_DIR=data/feed_media
# FEED_PAPERS=1
# FEED_PAPER_HOUR=9
# FEED_DEMO=off

# The goal check (agent/src/align.js, docs/security.md "Goal check"): LlamaFirewall's AlignmentCheck on Muse Glimmer,
# before the Autopilot asks for approval and before the reading agent posts. On when ALIGN_URL is set; ALIGN_CHECK=off
# turns it off, ALIGN_CHECK=on uses LLM_URL. A check that does not run counts as not aligned (a draft; the post waits)
# ALIGN_URL=http://127.0.0.1:11435/v1
# ALIGN_CHECK=on
# ALIGN_PYTHON=../attack/lfenv/bin/python
# ALIGN_THINK=low
# ALIGN_TIMEOUT_MS=120000
