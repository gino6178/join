# Join server settings. Copy to api/.env (never commit .env).

# Where the server listens, and the address people and PayPal reach it at (PayPal's return URLs and webhooks)
PORT=8790
PUBLIC_URL=http://localhost:8790

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox). Without these, Join runs on a PayPal
# stand-in that moves no money and says so on every page. Enable "Payouts" and "Vault" in the app's features.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The webhook's id from the same app (Webhooks), for signature checks. PayPal only delivers to HTTPS on port 443:
# use a tunnel (cloudflared tunnel --url http://localhost:8790) and set PUBLIC_URL to it.
PAYPAL_WEBHOOK_ID=
# PAYPAL_MODE=mock forces the stand-in even with keys set
# PAYPAL_MODE=

# Demo sign-in: pick a made-up player on the website. Set to 0 behind a real login.
DEMO_SIGNIN=1

# Keep state on disk across restarts (default: in memory)
# NEGOTIATIONS_FILE=data/state/negotiations.json
# BOOKINGS_FILE=data/state/bookings.json
# MANDATES_FILE=data/state/mandates.json
# TOKENS_FILE=data/state/tokens.json
# ACTIVITY_FILE=data/state/activity.json

# Verifiable receipts on an EVM chain (a zero-value transaction carrying a Merkle root; no token, no contract).
# Development: a local chain. Start it with `npm run chain` (Hardhat; or Anvil), then use its RPC and one of the
# development private keys it prints (well known, never use them anywhere real). Every batch goes on chain.
# Production: a public chain (e.g. Base Sepolia, chain id 84532) with a key made only for this and a little test ETH;
# batches stay off chain and POST /api/receipts/seal writes ONE transaction sealing all of them (ANCHOR_MODE=seal,
# the default off the local chain). The seal endpoint needs ADMIN_TOKEN as a bearer token when DEMO_SIGNIN=0.
ANCHOR_RPC_URL=
ANCHOR_PRIVATE_KEY=
# ANCHOR_MODE=each|seal
# ANCHOR_MS=600000
# ADMIN_TOKEN=

# Join's website agent (for people without an agent). Without SCOUT_LLM_URL it uses rules only.
# With an Ollama that has the model (ollama pull qwen2.5:0.5b), Qwen also reads free-form sentences. No AI key.
# SCOUT_LLM_URL=http://127.0.0.1:11434
# SCOUT_MODEL=qwen2.5:0.5b
